{
	"name": "stfc-mod-new-launcher",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --noEmit && vite build",
		"sync:modconfig": "node scripts/sync-modconfig.mjs",
		"build:macos": "pnpm tauri build --bundles dmg --target universal-apple-darwin",
		"build:windows": "pnpm exec tauri build --bundles msi --ci",
		"build:windows:arm64": "pnpm exec tauri build --bundles msi --target aarch64-pc-windows-msvc --ci",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"tauri": "tauri",
		"prepare": "husky",
		"lint": "biome check --write",
		"format": "biome format --write",
		"check": "biome check && cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.3",
		"@tauri-apps/plugin-fs": "~2.5.2",
		"@tauri-apps/plugin-opener": "^2.5.5",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.11.0",
		"toml": "^5.0.0",
		"vue": "^3.5.43"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^24.13.5",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vue/test-utils": "^2.5.1",
		"git-format-staged": "^4.0.2",
		"husky": "^9.1.7",
		"jsdom": "^30.1.0",
		"typescript": "^5.9.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"vue-tsc": "^3.3.11"
	},
	"packageManager": "pnpm@11.27.0"
}
